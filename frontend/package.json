{
  "name": "openshell-dashboard",
  "version": "0.0.0-semantically-released",
  "description": "OpenShell Dashboard frontend — React + PatternFly 6 admin UI for the OpenShell gateway",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gkrumbach07/openshell-dashboard"
  },
  "main": "dist/pages/index.js",
  "module": "dist/pages/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    "./pages": {
      "types": "./dist/pages/index.d.ts",
      "default": "./dist/pages/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./slots": {
      "types": "./dist/slots/index.d.ts",
      "default": "./dist/slots/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}'",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "e2e": "cypress run",
    "e2e:open": "cypress open",
    "e2e:integration": "cypress run --config-file cypress.config.integration.ts",
    "e2e:integration:open": "cypress open --config-file cypress.config.integration.ts",
    "build:lib": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@patternfly/react-code-editor": "^6.6.0",
    "@patternfly/react-core": "^6.2.0",
    "@patternfly/react-icons": "^6.2.0",
    "@patternfly/react-log-viewer": "^6.5.0",
    "@patternfly/react-table": "^6.2.0",
    "@tanstack/react-query": "^5.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "dependencies": {
    "@patternfly/react-code-editor": "^6.6.0",
    "@patternfly/react-core": "^6.2.0",
    "@patternfly/react-icons": "^6.2.0",
    "@patternfly/react-log-viewer": "^6.5.0",
    "@patternfly/react-table": "^6.2.0",
    "@tanstack/react-query": "^5.59.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "css-loader": "^7.1.2",
    "cypress": "^15.19.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "monaco-editor-webpack-plugin": "^7.1.1",
    "prettier": "^3.9.6",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "tsc-alias": "^1.8.15",
    "typescript": "^5.6.3",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  }
}
