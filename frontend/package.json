{
  "name": "openshell-dashboard",
  "version": "0.0.0-semantically-released",
  "private": true,
  "description": "OpenShell Dashboard frontend — React + PatternFly 6 admin UI for the OpenShell gateway",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gkrumbach07/openshell-dashboard"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}' vite.config.ts",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}' vite.config.ts",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' vite.config.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "e2e": "cypress run",
    "e2e:open": "cypress open"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@patternfly/react-code-editor": "^6.6.0",
    "@patternfly/react-core": "^6.2.0",
    "@patternfly/react-icons": "^6.2.0",
    "@patternfly/react-log-viewer": "^6.5.0",
    "@patternfly/react-table": "^6.2.0",
    "@tanstack/react-query": "^5.59.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "i18next": "^26.3.6",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^6.30.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^5.1.0",
    "cypress": "^15.19.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3",
    "vite": "^7.1.0"
  }
}
