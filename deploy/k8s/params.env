# Container image for this install (BFF + static frontend).
dashboard-image=quay.io/gkrumbach07/openshell-dashboard:latest

# gRPC endpoint of THE gateway this install serves. One install, one gateway.
gateway-url=openshell-gateway.openshell.svc.cluster.local:50051

# Public OIDC client metadata advertised on /api/v1/auth/config. These must match
# what the gateway was started with (--oidc-issuer / --oidc-audience) — an
# embedding host reads them to offer a sign-in, and a mismatch surfaces only as a
# gateway refusal several hops away with no useful diagnostic.
oidc-issuer=
oidc-client-id=openshell-dashboard
oidc-audience=
